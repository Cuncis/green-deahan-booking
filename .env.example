APP_NAME="Green Deahan Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Zona waktu aplikasi: waktu di database, log, jadwal, dan tampilan memakai WIB.
# Mengganti ini setelah ada data membuat waktu lama bergeser, jadi biarkan.
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Penerima notifikasi internal platform (misalnya pendaftar tenant baru).
ADMIN_EMAIL=hello@greendeahan.com

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAJIB diganti dari 'log' ke 'resend' di production (driver API Resend
# bawaan Laravel, lihat config/mail.php & config/services.php). Isi
# RESEND_API_KEY dari resend.com/api-keys. Email verifikasi
# (MustVerifyEmail aktif) tidak akan pernah terkirim ke user selama masih
# 'log', jadi staf tenant tidak akan bisa lolos halaman verify-email.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@greendeahan.com"
MAIL_FROM_NAME="${APP_NAME}"
# Alternatif lewat SMTP Resend (sama-sama butuh domain pengirim terverifikasi di
# resend.com): MAIL_MAILER=smtp, MAIL_HOST=smtp.resend.com, MAIL_PORT=587,
# MAIL_USERNAME=resend, MAIL_PASSWORD=<RESEND_API_KEY>, MAIL_SCHEME=null.

# Monitoring error (config/monitoring.php, config/pulse.php):
# - Superadmin > Pengaturan > Log Error membaca storage/logs/laravel*.log.
# - Peringatan error: lonceng ke semua superadmin dan email ke penerima pilihan
#   (Pengaturan > Email & Notifikasi), sekali per jam untuk error yang sama.
#   Email terkirim lewat mailer di atas; uji dengan tombol "Kirim email uji".
# - Monitoring Server (/pulse) hanya untuk superadmin. Kartu server (CPU,
#   memori, disk) butuh proses `php artisan pulse:check` yang selalu hidup
#   (Supervisor); kartu lain terisi sendiri dari lalu lintas aplikasi.
PERINGATAN_ERROR_AKTIF=true
PERINGATAN_ERROR_JEDA_MENIT=60
LOG_ERROR_MAKS_MB=8
PULSE_ENABLED=true

# Untuk production multi-server, ganti FILESYSTEM_DISK=s3 supaya foto
# lapangan/galeri/logo/artikel (lewat App\Services\FotoUploadService)
# tersimpan di storage bersama (Cloudflare R2, S3-compatible), bukan disk
# lokal tiap server:
#   1. Buat bucket R2 di dashboard Cloudflare, buat API token S3-nya.
#   2. AWS_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com
#   3. Aktifkan akses publik bucket (r2.dev) ATAU hubungkan custom domain,
#      lalu isi AWS_URL dengan domain publik itu (wajib, dipakai
#      FotoUploadService bikin URL foto, R2 TIDAK dukung
#      Storage::url() bawaan tanpa ini).
#   4. FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
# Opsional: simpan semua foto di folder ini di dalam bucket (mis. green-deahan).
# Alamat fotonya jadi AWS_URL/green-deahan/produk/xxx.jpg. Jangan tulis folder ini juga di AWS_URL.
AWS_ROOT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mayar.id, satu akun untuk booking, langganan tenant, dan toko online
# (lihat config/mayar.php). SEMUA MODE SANDBOX sampai siap live:
#   1. Daftar/masuk dashboard sandbox https://web.mayar.io
#   2. Menu Integration > API Key, buat key, tempel di MAYAR_API_KEY
#   3. Isi MAYAR_WEBHOOK_TOKEN dengan teks acak panjang buatan sendiri, lalu
#      daftarkan URL webhook di menu Integration > Webhook:
#      https://<domain>/api/webhook/pembayaran?token=<MAYAR_WEBHOOK_TOKEN>
# Sandbox Mayar ada di web.mayar.io dan api.mayar.io (alamat lama .club
# sudah tidak ada). Kalau key kamu dari alamat lain, ubah MAYAR_BASE_URL.
# Go-live: MAYAR_ENV=production, MAYAR_BASE_URL=https://api.mayar.id,
# dan API key produksi.
MAYAR_ENV=sandbox
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.io
MAYAR_WEBHOOK_TOKEN=

# Sistem booking (config/situs.php). false: /sistem-booking tetap bisa dibuka
# lewat alamat langsung, tapi tidak ada di menu/sitemap dan tidak diindeks Google.
SISTEM_BOOKING_PUBLIK=false

# Toko online (config/toko.php). TOKO_PUBLIK=false: /toko tetap bisa dibuka
# lewat alamat langsung untuk uji internal, tapi tidak ada di menu dan tidak
# diindeks Google. Ganti ke true saat toko dibuka untuk umum.
TOKO_PUBLIK=false
TOKO_ONGKIR_FLAT=15000

# Ongkir toko: RajaOngkir lebih dulu (gratis, 100 permintaan per hari), lalu
# Biteship (Rp5 per permintaan) kalau batas harian RajaOngkir habis atau RajaOngkir
# gagal. Dropship: barang dikirim supplier, jadi hanya tarif yang dihitung, resi
# tetap diisi manual di admin. Tanpa kedua API key, checkout memakai ongkir flat di atas.
#
# RajaOngkir (utama): daftar di https://rajaongkir.com, buat API key, tempel di bawah.
# Kurir dipisah titik dua. Tiap pencarian lokasi dan hitung tarif dihitung satu
# permintaan, hasilnya disimpan di cache supaya kuota awet.
RAJAONGKIR_API_KEY=
RAJAONGKIR_COURIERS=jne:jnt:sicepat:anteraja
RAJAONGKIR_BATAS_HARIAN=100
RAJAONGKIR_SISA_AMAN=2
#
# Biteship (cadangan, tarif JNE, J&T, SiCepat, AnterAja). Cara pasang:
#   1. Daftar di https://biteship.com, aktifkan "Testing Mode" di dashboard
#   2. https://dashboard.biteship.com/integrations > buat API key (awalan biteship_test.)
#   3. Tempel di BITESHIP_API_KEY. Selama BITESHIP_ENV bukan production, key
#      biteship_live. ditolak.
#   4. Isi "Kode pos asal pengiriman" tiap supplier di Admin > Toko > Supplier,
#      atau BITESHIP_ORIGIN_POSTAL_CODE sebagai cadangan (dipakai kedua penyedia).
# Isi berat (gram) tiap produk: tarif dihitung dari berat.
BITESHIP_ENV=sandbox
BITESHIP_API_KEY=
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
BITESHIP_ORIGIN_POSTAL_CODE=
# Tambahan persen per paket (dibulatkan ke atas per Rp500) untuk supplier yang mengirim dari cabang mana pun yang punya stok. 0 = mati.
BITESHIP_CADANGAN_PERSEN=10
# Kalau semua penyedia ongkir gagal, checkout menawarkan ongkir tetap (TOKO_ONGKIR_FLAT) supaya pembeli tetap bisa membayar. false = tolak checkout.
BITESHIP_ONGKIR_DARURAT=true
TOKO_EMAIL_ADMIN=

VITE_APP_NAME="${APP_NAME}"
