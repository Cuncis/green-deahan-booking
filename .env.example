APP_NAME="Green Deahan Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Penerima notifikasi internal platform (misalnya pendaftar tenant baru).
ADMIN_EMAIL=admin@greendeahan.com

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAJIB diganti dari 'log' ke driver SMTP asli (smtp/ses/postmark/dst) di
# production. Email verifikasi (MustVerifyEmail aktif) tidak akan pernah
# terkirim ke user selama masih 'log', jadi staf tenant tidak akan bisa
# lolos halaman verify-email.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@greendeahan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk production multi-server, ganti FILESYSTEM_DISK=s3 supaya foto
# lapangan dan logo tenant (LapanganAdminController, SettingsAdminController)
# tersimpan di storage bersama, bukan disk lokal tiap server. Kompatibel juga
# dengan Cloudflare R2 (isi AWS_ENDPOINT dengan endpoint R2 dan set
# AWS_USE_PATH_STYLE_ENDPOINT=true), bukan cuma AWS S3 asli.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# MIDTRANS_SERVER_KEY juga dipakai untuk verifikasi signature webhook
# (PembayaranController::verifyMidtransSignature()), dan sekarang juga
# untuk PaymentService membuat transaksi Midtrans Core API yang
# sesungguhnya (QRIS/VA/GoPay). Ambil server key & client key dari
# dashboard.sandbox.midtrans.com untuk testing, JANGAN pakai key production
# sebelum benar-benar siap live (MIDTRANS_IS_PRODUCTION=true).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_CALLBACK_TOKEN=

VITE_APP_NAME="${APP_NAME}"
