APP_NAME="Green Deahan Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Penerima notifikasi internal platform (misalnya pendaftar tenant baru).
ADMIN_EMAIL=hello@greendeahan.com

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAJIB diganti dari 'log' ke 'resend' di production (driver API Resend
# bawaan Laravel, lihat config/mail.php & config/services.php). Isi
# RESEND_API_KEY dari resend.com/api-keys. Email verifikasi
# (MustVerifyEmail aktif) tidak akan pernah terkirim ke user selama masih
# 'log', jadi staf tenant tidak akan bisa lolos halaman verify-email.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@greendeahan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk production multi-server, ganti FILESYSTEM_DISK=s3 supaya foto
# lapangan/galeri/logo/artikel (lewat App\Services\FotoUploadService)
# tersimpan di storage bersama (Cloudflare R2, S3-compatible), bukan disk
# lokal tiap server:
#   1. Buat bucket R2 di dashboard Cloudflare, buat API token S3-nya.
#   2. AWS_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com
#   3. Aktifkan akses publik bucket (r2.dev) ATAU hubungkan custom domain,
#      lalu isi AWS_URL dengan domain publik itu (wajib, dipakai
#      FotoUploadService bikin URL foto, R2 TIDAK dukung
#      Storage::url() bawaan tanpa ini).
#   4. FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# MAYAR_API_KEY dipakai PaymentService membuat invoice Mayar sesungguhnya
# (QRIS/VA/e-wallet/dst). MAYAR_WEBHOOK_TOKEN adalah shared secret pilihan
# sendiri yang didaftarkan sebagai query string di URL webhook Mayar
# (.../api/webhook/pembayaran?token=...), dipakai PembayaranController
# untuk verifikasi (Mayar tidak sign body webhook-nya). Ambil API key dari
# https://web.mayar.club/api-keys untuk testing (sandbox), JANGAN pakai key
# production sebelum benar-benar siap live (MAYAR_IS_PRODUCTION=true).
MAYAR_API_KEY=
MAYAR_WEBHOOK_TOKEN=
MAYAR_IS_PRODUCTION=false

VITE_APP_NAME="${APP_NAME}"
