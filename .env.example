APP_NAME="Green Deahan Sport"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Penerima notifikasi internal platform (misalnya pendaftar tenant baru).
ADMIN_EMAIL=hello@greendeahan.com

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# WAJIB diganti dari 'log' ke 'resend' di production (driver API Resend
# bawaan Laravel, lihat config/mail.php & config/services.php). Isi
# RESEND_API_KEY dari resend.com/api-keys. Email verifikasi
# (MustVerifyEmail aktif) tidak akan pernah terkirim ke user selama masih
# 'log', jadi staf tenant tidak akan bisa lolos halaman verify-email.
MAIL_MAILER=log
RESEND_API_KEY=
MAIL_FROM_ADDRESS="noreply@greendeahan.com"
MAIL_FROM_NAME="${APP_NAME}"

# Untuk production multi-server, ganti FILESYSTEM_DISK=s3 supaya foto
# lapangan/galeri/logo/artikel (lewat App\Services\FotoUploadService)
# tersimpan di storage bersama (Cloudflare R2, S3-compatible), bukan disk
# lokal tiap server:
#   1. Buat bucket R2 di dashboard Cloudflare, buat API token S3-nya.
#   2. AWS_ENDPOINT = https://<account_id>.r2.cloudflarestorage.com
#   3. Aktifkan akses publik bucket (r2.dev) ATAU hubungkan custom domain,
#      lalu isi AWS_URL dengan domain publik itu (wajib, dipakai
#      FotoUploadService bikin URL foto, R2 TIDAK dukung
#      Storage::url() bawaan tanpa ini).
#   4. FILESYSTEM_DISK=s3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Mayar.id, satu akun untuk booking, langganan tenant, dan toko online
# (lihat config/mayar.php). SEMUA MODE SANDBOX sampai siap live:
#   1. Daftar/masuk dashboard sandbox https://web.mayar.io
#   2. Menu Integration > API Key, buat key, tempel di MAYAR_API_KEY
#   3. Isi MAYAR_WEBHOOK_TOKEN dengan teks acak panjang buatan sendiri, lalu
#      daftarkan URL webhook di menu Integration > Webhook:
#      https://<domain>/api/webhook/pembayaran?token=<MAYAR_WEBHOOK_TOKEN>
# Sandbox Mayar ada di web.mayar.io dan api.mayar.io (alamat lama .club
# sudah tidak ada). Kalau key kamu dari alamat lain, ubah MAYAR_BASE_URL.
# Go-live: MAYAR_ENV=production, MAYAR_BASE_URL=https://api.mayar.id,
# dan API key produksi.
MAYAR_ENV=sandbox
MAYAR_API_KEY=
MAYAR_BASE_URL=https://api.mayar.io
MAYAR_WEBHOOK_TOKEN=

# Sistem booking (config/situs.php). false: /sistem-booking tetap bisa dibuka
# lewat alamat langsung, tapi tidak ada di menu/sitemap dan tidak diindeks Google.
SISTEM_BOOKING_PUBLIK=false

# Toko online (config/toko.php). TOKO_PUBLIK=false: /toko tetap bisa dibuka
# lewat alamat langsung untuk uji internal, tapi tidak ada di menu dan tidak
# diindeks Google. Ganti ke true saat toko dibuka untuk umum.
TOKO_PUBLIK=false
TOKO_ONGKIR_FLAT=15000

# Ongkir Biteship (tarif JNE, J&T, SiCepat, AnterAja di checkout toko).
# Dropship: barang dikirim supplier, jadi hanya tarif yang dihitung, resi
# tetap diisi manual di admin. Cara pasang:
#   1. Daftar di https://biteship.com, aktifkan "Testing Mode" di dashboard
#   2. https://dashboard.biteship.com/integrations > buat API key (awalan biteship_test.)
#   3. Tempel di BITESHIP_API_KEY. Selama BITESHIP_ENV bukan production, key
#      biteship_live. ditolak. Kosongkan key untuk memakai ongkir flat di atas.
#   4. Isi "Kode pos asal pengiriman" tiap supplier di Admin > Toko > Supplier,
#      atau BITESHIP_ORIGIN_POSTAL_CODE sebagai cadangan.
# Isi berat (gram) tiap produk: tarif dihitung dari berat.
BITESHIP_ENV=sandbox
BITESHIP_API_KEY=
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
BITESHIP_ORIGIN_POSTAL_CODE=
# Tambahan persen per paket (dibulatkan ke atas per Rp500) untuk supplier yang mengirim dari cabang mana pun yang punya stok. 0 = mati.
BITESHIP_CADANGAN_PERSEN=10
# Kalau Biteship gagal, checkout menawarkan ongkir tetap (TOKO_ONGKIR_FLAT) supaya pembeli tetap bisa membayar. false = tolak checkout.
BITESHIP_ONGKIR_DARURAT=true
TOKO_EMAIL_ADMIN=

VITE_APP_NAME="${APP_NAME}"
